# ========================================================
# VidSnap Configuration & Authentication
# ========================================================

# Option 1: Instagram Session ID (Recommended for Instagram Stories & Highlights)
# How to get it:
# 1. Log in to instagram.com in Chrome / Edge / Firefox
# 2. Press F12 -> Application -> Storage -> Cookies -> https://www.instagram.com
# 3. Copy the value of "sessionid" and paste it below:
# INSTAGRAM_SESSION_ID=your_instagram_session_id_here

# Option 2: Path to Netscape cookies.txt file
# You can export cookies using browser extensions like "Get cookies.txt LOCALLY"
# and save it as cookies.txt in the vidsnap folder.
# COOKIES_PATH=./cookies.txt
